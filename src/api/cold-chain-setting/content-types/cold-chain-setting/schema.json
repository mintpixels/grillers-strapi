{
  "kind": "singleType",
  "collectionName": "cold_chain_settings",
  "info": {
    "singularName": "cold-chain-setting",
    "pluralName": "cold-chain-settings",
    "displayName": "ColdChainSettings",
    "description": "Cold chain shipping configuration for temperature-sensitive products"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "DryIcePricePerLb": {
      "type": "decimal",
      "required": false
    },
    "BoxCostMicro": {
      "type": "decimal",
      "required": false
    },
    "BoxCost330": {
      "type": "decimal",
      "required": false
    },
    "BoxCost345": {
      "type": "decimal",
      "required": false
    },
    "PackagingCostModel": {
      "type": "enumeration",
      "enum": [
        "legacy_tiered",
        "continuous_weight"
      ],
      "default": "legacy_tiered",
      "required": false
    },
    "MinimumDryIceAmount": {
      "type": "decimal",
      "required": false
    },
    "TemperatureThreshold": {
      "type": "decimal",
      "required": false
    },
    "ColdChainSurcharge": {
      "type": "decimal",
      "required": false
    },
    "Enabled": {
      "type": "boolean",
      "default": true,
      "required": false
    },
    "TransitDayThresholds": {
      "type": "component",
      "repeatable": true,
      "component": "checkout.transit-threshold"
    },
    "PackagingBoxes": {
      "type": "component",
      "repeatable": true,
      "component": "checkout.packaging-box-rule"
    },
    "PackingPolicyVersion": {
      "type": "string",
      "required": false,
      "description": "Reviewed revision of the whole-unit packing policy, dimensions, ice, tare, gross limit and fit rules. Leave blank until the operating rules are approved."
    },
    "SeasonalPackingPolicies": {
      "type": "component",
      "repeatable": true,
      "component": "checkout.seasonal-packing-policy"
    },
    "DryIceBlockWeightLb": {
      "type": "decimal",
      "min": 0,
      "required": false,
      "description": "Physical pounds in one dry-ice block. Keep separate from the minimum ice pounds. No default; enter the reviewed current block size before publishing."
    }
  }
}
